#!name=NodeSeek签到
#!desc=NodeSeek 每日 08:10 自动签到。安装后先在浏览器登录态下打开一次 nodeseek.com 抓取 Cookie，之后每天 08:10 自动跑。
#!author=Qi

[Script]
NodeSeek每日签到 = type=cron,cronexp="10 8 * * *",script-path=https://raw.githubusercontent.com/qidor/Kido/main/checkin-nodeseek.js,wake-system=true,timeout=60
NodeSeek Cookie获取 = type=http-request,pattern=^https://www\.nodeseek\.com/,script-path=https://raw.githubusercontent.com/qidor/Kido/main/checkin-cookie-v2.js,requires-body=false

[MITM]
hostname = %APPEND% www.nodeseek.com
