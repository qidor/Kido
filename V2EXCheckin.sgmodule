#!name=V2EX签到
#!desc=V2EX 每日 08:10 自动签到。安装后先在浏览器登录态下打开一次 v2ex.com 抓取 Cookie，之后每天 08:10 自动跑。
#!author=Qi

[Script]
V2EX每日签到 = type=cron,cronexp="10 8 * * *",script-path=https://raw.githubusercontent.com/qidor/Kido/main/checkin-v2ex.js,wake-system=true,timeout=60
V2EX Cookie获取 = type=http-request,pattern=^https://www\.v2ex\.com/,script-path=https://raw.githubusercontent.com/qidor/Kido/main/checkin-cookie-v2.js,requires-body=false

[MITM]
hostname = %APPEND% www.v2ex.com
