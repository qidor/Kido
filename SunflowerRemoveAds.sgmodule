#!name=向日葵去广告
#!desc=去除向日葵远程控制开屏、首页横幅与弹窗广告；只清理接口 JSON 里的广告字段，不动远控、登录与会员功能
#!author=QiMonitor
#!category=去广告

# 说明：
# - 本模块用脚本清理向日葵接口 JSON 里的广告字段（开屏/横幅/弹窗），不封远控域名。
# - 远控会话不走 HTTPS JSON 接口，不受影响。
# - 脚本解析失败或响应里没有广告字段时原样放行，不会把正常内容改坏。
# - 如装上后向日葵打开异常，关掉本模块即恢复。
# - 旧的「向日葵去广告」模块（更新失败那个）建议先关掉，避免两套规则叠加。

[MITM]
hostname = %APPEND% *.oray.com, *.sunlogin.oray.com

[Script]
向日葵去广告 = type=http-response, pattern=^https?://[^/]+\.(oray\.com|sunlogin\.oray\.com), script-path=https://raw.githubusercontent.com/qidor/Kido/main/sunflower-remove-ads.js, requires-body=true
