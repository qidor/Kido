#!name=什么值得买签到
#!desc=什么值得买每日 08:10 自动签到领金币。Cookie 在 Edge 登录 www.smzdm.com 后抓取。
#!author=Qi

[Script]
什么值得买每日签到 = type=cron,cronexp="10 8 * * *",script-path=https://raw.githubusercontent.com/qidor/Kido/main/checkin-smzdm.js,wake-system=true,timeout=60
什么值得买 Cookie获取 = type=http-request,pattern=^https://www\.smzdm\.com/,script-path=https://raw.githubusercontent.com/qidor/Kido/main/checkin-cookie-v2.js,requires-body=false

[MITM]
hostname = %APPEND% www.smzdm.com
